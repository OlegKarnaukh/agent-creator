{
  "name": "Channel",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "ID \u0430\u0433\u0435\u043d\u0442\u0430"
    },
    "type": {
      "type": "string",
      "enum": [
        "telegram",
        "whatsapp",
        "phone",
        "website"
      ],
      "description": "\u0422\u0438\u043f \u043a\u0430\u043d\u0430\u043b\u0430"
    },
    "credentials": {
      "type": "object",
      "description": "\u0423\u0447\u0451\u0442\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043a\u0430\u043d\u0430\u043b\u0430 (bot_token \u0434\u043b\u044f Telegram, API \u043a\u043b\u044e\u0447\u0438 \u0434\u043b\u044f WhatsApp \u0438 \u0442.\u0434.)",
      "properties": {
        "bot_token": {
          "type": "string"
        },
        "api_key": {
          "type": "string"
        },
        "phone_number": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "error"
      ],
      "default": "pending",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043a\u0430\u043d\u0430\u043b\u0430"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL \u0432\u0435\u0431\u0445\u0443\u043a\u0430 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043a\u0430\u043d\u0430\u043b\u0430"
    },
    "webhook_secret": {
      "type": "string",
      "description": "\u0421\u0435\u043a\u0440\u0435\u0442 \u0434\u043b\u044f \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u0438 \u0432\u0435\u0431\u0445\u0443\u043a\u043e\u0432"
    },
    "last_error": {
      "type": "string",
      "description": "\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f"
    },
    "metadata": {
      "type": "object",
      "description": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 (\u0438\u043c\u044f \u0431\u043e\u0442\u0430, username \u0438 \u0442.\u0434.)"
    }
  },
  "required": [
    "agent_id",
    "type",
    "credentials"
  ]
}
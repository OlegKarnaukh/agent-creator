{
  "name": "Billing",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "enterprise"
      ],
      "default": "free",
      "description": "\u0422\u0435\u043a\u0443\u0449\u0438\u0439 \u0442\u0430\u0440\u0438\u0444"
    },
    "tokens_used": {
      "type": "number",
      "default": 0,
      "description": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043e \u0442\u043e\u043a\u0435\u043d\u043e\u0432"
    },
    "tokens_limit": {
      "type": "number",
      "default": 100000,
      "description": "\u041b\u0438\u043c\u0438\u0442 \u0442\u043e\u043a\u0435\u043d\u043e\u0432"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "\u041d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0441\u0447\u0451\u0442\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "\u041a\u043e\u043d\u0435\u0446 \u0440\u0430\u0441\u0447\u0451\u0442\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430"
    }
  },
  "required": [
    "user_id"
  ]
}
{
  "name": "CallHistory",
  "type": "object",
  "properties": {
    "\u043a\u043e\u043d\u0442\u0430\u043a\u0442_id": {
      "type": "string",
      "description": "ID \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430"
    },
    "\u043a\u0430\u043c\u043f\u0430\u043d\u0438\u044f_id": {
      "type": "string",
      "description": "ID \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438"
    },
    "\u0434\u0430\u0442\u0430_\u0432\u0440\u0435\u043c\u044f": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0437\u0432\u043e\u043d\u043a\u0430"
    },
    "\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442": {
      "type": "string",
      "enum": [
        "\u0443\u0441\u043f\u0435\u0445",
        "\u0438\u043d\u0442\u0435\u0440\u0435\u0441",
        "\u043f\u0435\u0440\u0435\u0437\u0432\u043e\u043d\u0438\u0442\u044c",
        "\u043e\u0442\u043a\u0430\u0437",
        "\u043d\u0435\u0434\u043e\u0437\u0432\u043e\u043d",
        "\u0437\u0430\u043d\u044f\u0442\u043e",
        "\u0430\u0432\u0442\u043e\u043e\u0442\u0432\u0435\u0442\u0447\u0438\u043a"
      ],
      "description": "\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0437\u0432\u043e\u043d\u043a\u0430"
    },
    "\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c": {
      "type": "number",
      "default": 0,
      "description": "\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432 \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u0445"
    },
    "\u0437\u0430\u043f\u0438\u0441\u044c_url": {
      "type": "string",
      "description": "URL \u0437\u0430\u043f\u0438\u0441\u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430"
    },
    "\u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u044f": {
      "type": "string",
      "description": "\u0422\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0438\u044f \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430"
    }
  },
  "required": [
    "\u043a\u043e\u043d\u0442\u0430\u043a\u0442_id",
    "\u043a\u0430\u043c\u043f\u0430\u043d\u0438\u044f_id",
    "\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442"
  ]
}